PORT=8080
APP_ENV=development
DATABASE_URL=postgres://agora_user:agora_password@agora-postgres:5432/agora_db?sslmode=disable
REDIS_ADDR=agora-redis:6379
TEMPORAL_HOST=agora-temporal:7233
TEMPORAL_TASK_QUEUE=agora-governance

# 生产环境必须替换为随机长字符串。
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=72

# OpenAI 兼容接口。真实密钥只写入 backend/.env，禁止提交。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 开发环境使用短等待以便演示；production 会使用服务端安全默认值。
GOVERNANCE_COOLING_SECONDS=60
GOVERNANCE_REPLY_DWELL_SECONDS=10
GOVERNANCE_LONG_TOPIC_CHARS=800
